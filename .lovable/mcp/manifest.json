{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://uactagkdvafjombseswx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "aetheris-intros",
      "version": "0.1.0",
      "title": "Ask Intros"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Read the signed-in member's own Ask Intros profile: focus, thesis, looking for, can help with, boundaries, availability, industries and expertise.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "search_members",
        "title": "Search members",
        "description": "Search verified Ask Intros members by name, role, company, focus, what they are looking for or what they can help with. Returns only what members state on their own profiles; never infer more.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Free text to match against name, title, company, focus, bio, what they want or what they offer.",
              "type": "string",
              "minLength": 1
            },
            "industry": {
              "description": "Restrict results to members who list this industry.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 10,
              "description": "Maximum members to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_member",
        "title": "Get member",
        "description": "Read one verified Ask Intros member's own stated profile: focus, what they are looking for, what they can help with, availability and what they are open to.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "member_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The member id returned by search_members."
            }
          },
          "required": [
            "member_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_asks",
        "title": "List network asks",
        "description": "List the professional asks (what members need right now) visible to the signed-in member, newest first. Optionally filter by industry or urgency.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "industry": {
              "description": "Restrict asks to one industry.",
              "type": "string",
              "minLength": 1
            },
            "urgency": {
              "description": "Restrict asks to one urgency level.",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "limit": {
              "default": 15,
              "description": "Maximum asks to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "post_ask",
        "title": "Post an ask",
        "description": "Post a professional ask for the signed-in member: what they need right now, why now, and what they can offer in return. No mass outreach — one clear ask at a time.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "ask": {
              "type": "string",
              "minLength": 4,
              "description": "The ask in one sentence."
            },
            "detail": {
              "description": "Context that helps someone judge whether they can help.",
              "type": "string"
            },
            "why_now": {
              "description": "Why the timing matters.",
              "type": "string"
            },
            "offer": {
              "description": "What the member gives in return.",
              "type": "string"
            },
            "industry": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "urgency": {
              "default": "medium",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "visibility": {
              "default": "network",
              "type": "string",
              "enum": [
                "network",
                "private"
              ]
            }
          },
          "required": [
            "ask"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "request_intro",
        "title": "Request an introduction",
        "description": "Request a double opt-in introduction to a member for the signed-in member. Every request carries a context capsule — why this introduction exists, why the member may care, why the other person may care, and why now — written from what the member actually told you. The other side reviews that capsule before opting in, so this never sends a pitch. Do not invent reasons; ask the member if any answer is missing.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "member_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The live member to be introduced to (their member id from search_members)."
            },
            "why_exists": {
              "type": "string",
              "minLength": 12,
              "maxLength": 600,
              "description": "Why this introduction should exist at all."
            },
            "why_requester": {
              "type": "string",
              "minLength": 12,
              "maxLength": 600,
              "description": "Why the signed-in member may care."
            },
            "why_target": {
              "type": "string",
              "minLength": 12,
              "maxLength": 600,
              "description": "Why the other person may care — what is in it for them."
            },
            "why_now": {
              "type": "string",
              "minLength": 12,
              "maxLength": 600,
              "description": "Why the timing is right now."
            },
            "first_goal": {
              "default": "",
              "description": "Goal for the first conversation, if the member stated one.",
              "type": "string",
              "maxLength": 400
            }
          },
          "required": [
            "member_id",
            "why_exists",
            "why_requester",
            "why_target",
            "why_now"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_intro_requests",
        "title": "List my introductions",
        "description": "List the signed-in member's introduction requests with their double opt-in status, reason and mutual value.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by status.",
              "type": "string",
              "enum": [
                "requested",
                "accepted",
                "declined",
                "connected"
              ]
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_memories",
        "title": "List Active Memory",
        "description": "List the signed-in member's Active Memory entries — learned context about people, needs, timing and commitments, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "category": {
              "description": "Filter by category, e.g. People, Needs, Timing.",
              "type": "string",
              "minLength": 1
            },
            "member_id": {
              "description": "Only memories about this member.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "add_memory",
        "title": "Add to Active Memory",
        "description": "Record a piece of learned context in the signed-in member's Active Memory so future introductions and timing improve. Private by default.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 4,
              "description": "The observation, commitment or context to remember."
            },
            "category": {
              "default": "People",
              "description": "e.g. People, Needs, Timing, Commitments.",
              "type": "string",
              "minLength": 1
            },
            "member_id": {
              "description": "The member this context is about, if any.",
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "default": "private",
              "type": "string",
              "enum": [
                "private",
                "team",
                "organization",
                "shareable",
                "public"
              ]
            },
            "confidence": {
              "default": 100,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "text"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_outcome_checkins",
        "title": "List introductions due for a follow-up",
        "description": "List the signed-in member's accepted introductions that are due an outcome check-in (7, 30 or 90 days after acceptance). Ask the member what happened, then record it with record_intro_outcome.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "record_intro_outcome",
        "title": "Record what an introduction led to",
        "description": "Append what happened after an accepted introduction, as the signed-in member said it. Only record what the member actually told you — never infer an outcome. Private unless the member explicitly asks to share it with the other participant.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "intro_request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The accepted introduction."
            },
            "stage": {
              "type": "string",
              "enum": [
                "too_early",
                "met",
                "next_step",
                "outcome",
                "no_outcome"
              ]
            },
            "outcome_category": {
              "description": "Required when stage is 'outcome'.",
              "type": "string",
              "enum": [
                "customer",
                "partnership",
                "hire",
                "investor",
                "advisor",
                "board",
                "vendor",
                "acquisition",
                "knowledge",
                "other"
              ]
            },
            "attribution": {
              "default": "direct",
              "type": "string",
              "enum": [
                "direct",
                "influenced",
                "contextual"
              ]
            },
            "value_band": {
              "default": "undisclosed",
              "description": "Only if the member volunteered it; otherwise undisclosed.",
              "type": "string",
              "enum": [
                "undisclosed",
                "under_10k",
                "10k_100k",
                "100k_1m",
                "over_1m"
              ]
            },
            "private_note": {
              "default": "",
              "type": "string",
              "maxLength": 1000
            },
            "shareable": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "intro_request_id",
            "stage"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
